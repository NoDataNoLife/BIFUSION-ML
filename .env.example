APP_ENV=local

# AI Model Config
DEVICE=auto
IMAGE_SIZE=128
CHANNELS=1                 # 1=grayscale, 3=RGB

# Medfusion (유일한 생성 백엔드) — 배포 시 경로/가중치 반드시 설정
MEDFUSION_CODE_PATH=C:\Users\tjdgk\Desktop\My\PBL\medfusion_code
MEDFUSION_WEIGHTS_DIR=C:\Users\tjdgk\Desktop\My\PBL\medfusion_weights
MEDFUSION_DIFFUSION_CKPT=runs/chest_diffusion/last.ckpt
MEDFUSION_VAE_CKPT=runs/2022_12_12_133315_chest_vaegan/last_vae.ckpt
MEDFUSION_LATENT_SHAPE=8,32,32
MEDFUSION_GUIDANCE_SCALE=4.0
MEDFUSION_STEPS=50

# Model Loader: local | s3
MODEL_LOADER=local
MODEL_DIR=models
MODEL_CACHE_DIR=/tmp/models

# Storage: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage
S3_OUTPUT_PREFIX=outputs

# S3 (프로덕션 전환 시)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
MODEL_S3_BUCKET=
AWS_S3_BUCKET_NAME=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# DB
DATABASE_URL=postgresql://user:password@localhost:5432/bifusion
