APP_ENV=local

# Model Loader: local | s3
MODEL_LOADER=local
MODEL_DIR=models
MODEL_CACHE_DIR=/tmp/models

# S3 (프로덕션 전환 시)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
MODEL_S3_BUCKET=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# DB
DATABASE_URL=postgresql://user:password@localhost:5432/bifusion
