APP_ENV=local

# AI Model Config
DEVICE=auto
IMAGE_SIZE=128
CHANNELS=3                 # 1=grayscale, 3=RGB. eye VAE는 RGB(색 보존)

# 아래 경로는 배포(리눅스/RunPod) 예시값. 실제 설치 위치에 맞게 수정.
# 생성 로직이 담긴 bifusion 패키지 경로 (웹앱이 sys.path에 추가해 import)
BIFUSION_PACKAGE_PATH=/workspace/bifusion-pip

# Medfusion (유일한 생성 백엔드) — eye(fundus) VAE 단일 범용.
MEDFUSION_CODE_PATH=/workspace/medical_diffusion
MEDFUSION_WEIGHTS_DIR=/workspace/medfusion_weights
MEDFUSION_DIFFUSION_CKPT=runs/eye_diffusion/last.ckpt
MEDFUSION_VAE_CKPT=runs/2022_12_12_224914_eye_vaegan/last_vae.ckpt
MEDFUSION_LATENT_SHAPE=4,32,32
MEDFUSION_GUIDANCE_SCALE=4.0
MEDFUSION_STEPS=50

# 증강: per-upload 파인튜닝(fidelity-first)
MEDFUSION_FINETUNE_STEPS=400
MEDFUSION_FINETUNE_LR=0.0001
MEDFUSION_STRENGTH=0.3

# Model Loader: local | s3
MODEL_LOADER=local
MODEL_DIR=models
MODEL_CACHE_DIR=/tmp/models

# Storage: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage
S3_OUTPUT_PREFIX=outputs
# For training downloads: set S3_OUTPUT_PREFIX=ml-results and enable this flag.
TRAINING_PUBLISH_S3=false

# S3 (프로덕션 전환 시)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
MODEL_S3_BUCKET=
AWS_S3_BUCKET_NAME=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# DB
DATABASE_URL=postgresql://user:password@localhost:5432/bifusion
