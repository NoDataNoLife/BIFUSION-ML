APP_ENV=local

# AI Model Config
DEVICE=auto
IMAGE_SIZE=128
DEFAULT_TIMESTEPS=500
DEFAULT_MODEL_NAME=best_model.pt

# Model Loader: local | s3
MODEL_LOADER=local
MODEL_DIR=models
MODEL_CACHE_DIR=/tmp/models

# Storage: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage
S3_OUTPUT_PREFIX=outputs

# S3 (프로덕션 전환 시)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
MODEL_S3_BUCKET=
AWS_S3_BUCKET_NAME=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# DB
DATABASE_URL=postgresql://user:password@localhost:5432/bifusion
